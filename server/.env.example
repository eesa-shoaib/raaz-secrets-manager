# Required for local dev
MONGO_URI=
JWT_SECRET=
MASTER_KEY=
MASTER_KEY_VERSION=1

# Optional
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=0
JWT_EXPIRES_IN=7d
COOKIE_DOMAIN=
COOKIE_SAMESITE=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
SIGNUP_ALLOWED_DOMAINS=
LOG_LEVEL=info
# Optional Google/GitHub login. Leave all three values empty to disable a provider.
# Callback must use the browser-facing /api origin (including a proxy/rewrite).
# Client secrets stay on the server; never use VITE_ variables for them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5173/api/auth/oauth/github/callback
