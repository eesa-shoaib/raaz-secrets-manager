{
    "openapi": "3.0.3",
    "info": {
        "title": "Raaz API",
        "version": "1.0.0",
        "description": "MVP contract from API.md. Secret, audit-log and admin routes require further database-backed integration testing. State-changing requests require an Origin matching CLIENT_ORIGIN. Login sets an httpOnly cookie; configure Hoppscotch to send cookies."
    },
    "servers": [{ "url": "http://localhost:5000/api", "description": "Local server" }],
    "security": [{ "cookieAuth": [] }],
    "components": {
        "securitySchemes": { "cookieAuth": { "type": "apiKey", "in": "cookie", "name": "token" } },
        "parameters": {
            "projectId": {
                "name": "projectId",
                "in": "path",
                "required": true,
                "schema": { "type": "string" }
            },
            "userId": {
                "name": "userId",
                "in": "path",
                "required": true,
                "schema": { "type": "string" }
            },
            "secretId": {
                "name": "secretId",
                "in": "path",
                "required": true,
                "schema": { "type": "string" }
            },
            "origin": {
                "name": "Origin",
                "in": "header",
                "required": true,
                "schema": { "type": "string", "example": "http://localhost:5173" }
            }
        },
        "schemas": {
            "credentials": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                    "email": { "type": "string", "format": "email", "example": "user@example.com" },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "minLength": 8,
                        "maxLength": 72
                    }
                }
            },
            "role": { "type": "string", "enum": ["projectAdmin", "developer", "auditor"] },
            "environment": { "type": "string", "enum": ["development", "staging", "production"] }
        }
    },
    "paths": {
        "/auth/signup": {
            "post": {
                "summary": "Sign up",
                "security": [],
                "parameters": [{ "$ref": "#/components/parameters/origin" }],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/credentials" }
                        }
                    }
                },
                "responses": {
                    "201": { "description": "Account created" },
                    "422": { "description": "Invalid input" }
                }
            }
        },
        "/auth/login": {
            "post": {
                "summary": "Log in and set cookie",
                "security": [],
                "parameters": [{ "$ref": "#/components/parameters/origin" }],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/credentials" }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "Logged in" },
                    "401": { "description": "Invalid credentials" }
                }
            }
        },
        "/auth/logout": {
            "post": {
                "summary": "Log out",
                "parameters": [{ "$ref": "#/components/parameters/origin" }],
                "responses": { "204": { "description": "Logged out" } }
            }
        },
        "/auth/change-password": {
            "post": {
                "summary": "Change own password and invalidate sessions",
                "parameters": [{ "$ref": "#/components/parameters/origin" }],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["currentPassword", "newPassword"],
                                "properties": {
                                    "currentPassword": {
                                        "type": "string",
                                        "format": "password",
                                        "minLength": 1,
                                        "maxLength": 72
                                    },
                                    "newPassword": {
                                        "type": "string",
                                        "format": "password",
                                        "minLength": 8,
                                        "maxLength": 72
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "204": { "description": "Password updated and session cleared" },
                    "401": { "description": "Current password incorrect or unauthenticated" },
                    "422": { "description": "Validation error" }
                }
            }
        },
        "/auth/me": {
            "get": {
                "summary": "Current user",
                "responses": {
                    "200": { "description": "Current user" },
                    "401": { "description": "Unauthenticated" }
                }
            }
        },
        "/account/profile": {
            "patch": {
                "summary": "Update own username",
                "parameters": [{ "$ref": "#/components/parameters/origin" }],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["username"],
                                "properties": {
                                    "username": {
                                        "type": "string",
                                        "nullable": true,
                                        "example": "ali_dev"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "Updated user profile" },
                    "409": { "description": "Username already taken" },
                    "422": { "description": "Invalid username" }
                }
            }
        },
        "/account/avatar": {
            "put": {
                "summary": "Upload or replace own avatar",
                "parameters": [{ "$ref": "#/components/parameters/origin" }],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["contentType", "data"],
                                "properties": {
                                    "contentType": {
                                        "type": "string",
                                        "enum": ["image/png", "image/jpeg", "image/webp"]
                                    },
                                    "data": {
                                        "type": "string",
                                        "description": "Base64-encoded image bytes"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "Avatar updated" },
                    "422": { "description": "Invalid or oversized image" }
                }
            },
            "delete": {
                "summary": "Remove own avatar",
                "parameters": [{ "$ref": "#/components/parameters/origin" }],
                "responses": {
                    "200": { "description": "Avatar removed" }
                }
            }
        },
        "/users/{userId}/avatar": {
            "parameters": [{ "$ref": "#/components/parameters/userId" }],
            "get": {
                "summary": "Read user avatar binary (owner, shared project member, or Platform Admin)",
                "responses": {
                    "200": { "description": "Normalized raster image binary" },
                    "404": { "description": "No avatar or caller not authorized" }
                }
            }
        },
        "/projects": {
            "get": {
                "summary": "List projects",
                "parameters": [
                    { "name": "cursor", "in": "query", "schema": { "type": "string" } },
                    {
                        "name": "limit",
                        "in": "query",
                        "schema": { "type": "integer", "maximum": 100 }
                    },
                    { "name": "search", "in": "query", "schema": { "type": "string" } }
                ],
                "responses": { "200": { "description": "Projects" } }
            },
            "post": {
                "summary": "Create project",
                "parameters": [{ "$ref": "#/components/parameters/origin" }],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["name"],
                                "properties": {
                                    "name": { "type": "string", "example": "Demo" },
                                    "description": { "type": "string", "maxLength": 500 }
                                }
                            }
                        }
                    }
                },
                "responses": { "201": { "description": "Project created" } }
            }
        },
        "/projects/{projectId}": {
            "parameters": [{ "$ref": "#/components/parameters/projectId" }],
            "get": {
                "summary": "Get project",
                "responses": {
                    "200": { "description": "Project with role and memberCount" },
                    "404": { "description": "Not found or not a member" }
                }
            },
            "patch": {
                "summary": "Update project name or description (Project Admin only)",
                "parameters": [{ "$ref": "#/components/parameters/origin" }],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
                                    "description": { "type": "string", "maxLength": 500 }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "Updated project" },
                    "403": { "description": "Forbidden (logged as denied)" },
                    "404": { "description": "Not found or not a member" }
                }
            }
        },
        "/projects/{projectId}/members": {
            "parameters": [{ "$ref": "#/components/parameters/projectId" }],
            "get": {
                "summary": "List members",
                "responses": { "200": { "description": "Members" } }
            },
            "post": {
                "summary": "Add member",
                "parameters": [{ "$ref": "#/components/parameters/origin" }],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["email", "role"],
                                "properties": {
                                    "email": { "type": "string", "format": "email" },
                                    "role": { "$ref": "#/components/schemas/role" }
                                }
                            }
                        }
                    }
                },
                "responses": { "201": { "description": "Member added" } }
            }
        },
        "/projects/{projectId}/members/{userId}": {
            "parameters": [
                { "$ref": "#/components/parameters/projectId" },
                { "$ref": "#/components/parameters/userId" }
            ],
            "patch": {
                "summary": "Change member role",
                "parameters": [{ "$ref": "#/components/parameters/origin" }],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["role"],
                                "properties": { "role": { "$ref": "#/components/schemas/role" } }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "Role changed" },
                    "409": { "description": "Last admin" }
                }
            },
            "delete": {
                "summary": "Remove member",
                "parameters": [{ "$ref": "#/components/parameters/origin" }],
                "responses": {
                    "204": { "description": "Removed" },
                    "409": { "description": "Last admin" }
                }
            }
        },
        "/projects/{projectId}/secrets": {
            "parameters": [{ "$ref": "#/components/parameters/projectId" }],
            "get": {
                "summary": "List secrets",
                "parameters": [
                    {
                        "name": "environment",
                        "in": "query",
                        "required": true,
                        "schema": { "$ref": "#/components/schemas/environment" }
                    }
                ],
                "responses": { "200": { "description": "Masked secrets" } }
            },
            "post": {
                "summary": "Create secret",
                "parameters": [{ "$ref": "#/components/parameters/origin" }],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["key", "environment", "value"],
                                "properties": {
                                    "key": { "type": "string", "example": "API_KEY" },
                                    "environment": { "$ref": "#/components/schemas/environment" },
                                    "value": { "type": "string" }
                                }
                            }
                        }
                    }
                },
                "responses": { "201": { "description": "Created" } }
            }
        },
        "/projects/{projectId}/secrets/{secretId}": {
            "parameters": [
                { "$ref": "#/components/parameters/projectId" },
                { "$ref": "#/components/parameters/secretId" }
            ],
            "patch": {
                "summary": "Edit secret value",
                "parameters": [{ "$ref": "#/components/parameters/origin" }],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["value"],
                                "properties": { "value": { "type": "string" } }
                            }
                        }
                    }
                },
                "responses": { "200": { "description": "Updated" } }
            },
            "delete": {
                "summary": "Delete secret",
                "parameters": [{ "$ref": "#/components/parameters/origin" }],
                "responses": { "204": { "description": "Deleted" } }
            }
        },
        "/projects/{projectId}/secrets/{secretId}/reveal": {
            "parameters": [
                { "$ref": "#/components/parameters/projectId" },
                { "$ref": "#/components/parameters/secretId" }
            ],
            "post": {
                "summary": "Reveal secret",
                "parameters": [{ "$ref": "#/components/parameters/origin" }],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": { "confirm": { "type": "boolean", "default": false } }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "Decrypted value" },
                    "422": { "description": "Production confirmation required" }
                }
            }
        },
        "/projects/{projectId}/audit-log": {
            "parameters": [{ "$ref": "#/components/parameters/projectId" }],
            "get": {
                "summary": "Project audit log",
                "parameters": [
                    { "name": "action", "in": "query", "schema": { "type": "string" } },
                    {
                        "name": "result",
                        "in": "query",
                        "schema": { "type": "string", "enum": ["allowed", "denied"] }
                    },
                    {
                        "name": "environment",
                        "in": "query",
                        "schema": { "$ref": "#/components/schemas/environment" }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "schema": { "type": "integer", "maximum": 100 }
                    }
                ],
                "responses": { "200": { "description": "Audit entries" } }
            }
        },
        "/account/deactivate": {
            "post": {
                "summary": "Deactivate own user account",
                "parameters": [{ "$ref": "#/components/parameters/origin" }],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["currentPassword"],
                                "properties": {
                                    "currentPassword": { "type": "string", "minLength": 1 }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "204": { "description": "Account deactivated and session cleared" },
                    "401": { "description": "Invalid current password" },
                    "409": { "description": "Last active platform admin" }
                }
            }
        },
        "/admin/audit-log": {
            "get": {
                "summary": "Platform user administration audit log (platform-wide events only)",
                "parameters": [
                    {
                        "name": "action",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "platform_admin_granted",
                                "platform_admin_revoked",
                                "user_activated",
                                "user_deactivated"
                            ]
                        }
                    },
                    {
                        "name": "result",
                        "in": "query",
                        "schema": { "type": "string", "enum": ["allowed", "denied"] }
                    },
                    { "name": "cursor", "in": "query", "schema": { "type": "string" } },
                    {
                        "name": "limit",
                        "in": "query",
                        "schema": { "type": "integer", "maximum": 100 }
                    }
                ],
                "responses": { "200": { "description": "Platform audit entries" } }
            }
        },
        "/admin/users": {
            "get": {
                "summary": "List users (Platform Admins sorted first)",
                "parameters": [
                    { "name": "cursor", "in": "query", "schema": { "type": "string" } },
                    { "name": "page", "in": "query", "schema": { "type": "integer" } },
                    { "name": "limit", "in": "query", "schema": { "type": "integer" } }
                ],
                "responses": { "200": { "description": "Users" } }
            }
        },
        "/admin/users/{userId}": {
            "parameters": [{ "$ref": "#/components/parameters/userId" }],
            "patch": {
                "summary": "Update user status or admin role",
                "parameters": [{ "$ref": "#/components/parameters/origin" }],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "isActive": { "type": "boolean" },
                                    "isPlatformAdmin": { "type": "boolean" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "Updated" },
                    "403": { "description": "Self-demotion or self-deactivation forbidden" },
                    "409": { "description": "Last active platform admin" }
                }
            }
        }
    }
}
