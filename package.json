{
    "name": "raaz-secrets-manager",
    "version": "0.0.0",
    "private": true,
    "workspaces": [
        "client",
        "server",
        "packages/shared-schemas"
    ],
    "scripts": {
        "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
        "build": "npm run build -w packages/shared-schemas && npm run build -w server && npm run build -w client",
        "lint": "eslint . --ext .ts,.tsx",
        "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
        "test": "npm run test -w server && npm run test -w client",
        "test:server": "npm run test -w server",
        "test:client": "npm run test -w client"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "packageManager": "npm@10.5.0",
    "dependencies": {
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-router-dom": "6.30.6"
    },
    "devDependencies": {
        "@eslint/js": "9.39.5",
        "@rollup/rollup-win32-x64-msvc": "4.67.5",
        "eslint": "9.39.5",
        "eslint-config-prettier": "10.1.8",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-import": "2.32.0",
        "prettier": "3.9.10",
        "typescript-eslint": "8.72.1"
    }
}
